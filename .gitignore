# Astro's cache and logs. `site/.gitignore` already covers the one inside
# `site/`; this catches the one a stray `astro` command leaves at the repo
# root, which is how a preview log got committed on 2026-08-09.
.astro/

# Python bytecode from the skill scripts in .claude/skills/
__pycache__/
*.pyc

.DS_Store

# Permission approvals clicked in one terminal, on one machine. `.claude/
# settings.json` is the shared, reviewed allowlist and IS committed; this file
# is whatever "don't ask again" recorded locally, and it should never arrive in
# a pull request as though it were a decision.
.claude/settings.local.json

# /context-watch drafts. Unapproved article finds — review locally, never
# committed. An approved draft is promoted into `site/src/content/context/`
# by hand as its own explicit step; that's what enters git. Anchored to the
# repo root so it doesn't also swallow `site/src/content/`.
/content/

# Zoho credentials (tools/zoho-draft-push/) live at ~/.wardith/ and should
# never be inside this repo at all - these entries are belt-and-braces in
# case a local override ever points --credentials somewhere in here, same
# defensive reasoning as .claude/settings.local.json above.
zoho-credentials.json
.wardith/
