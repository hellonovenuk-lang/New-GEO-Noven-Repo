{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private review evidence ledger v1",
  "description": "Shape contract only. review_evidence.py also validates integrity, semantic evidence, supersession, lifecycle and budget history on every load. Keep real evidence outside the core repository.",
  "type": "object",
  "required": ["version", "campaign_slug", "campaign_sha256", "created_at", "records", "integrity_sha256"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "campaign_slug": {"type": "string", "minLength": 1},
    "campaign_sha256": {"$ref": "#/$defs/digest"},
    "integrity_sha256": {"$ref": "#/$defs/digest"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "source": {
      "type": "object",
      "required": ["url", "retrieved_at", "excerpt", "publisher", "role"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "retrieved_at": {"$ref": "#/$defs/timestamp"},
        "excerpt": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "role": {"enum": ["business", "registry", "independent"]}
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "recorded_at", "requirement", "state", "value", "sources", "method", "rationale", "reviewer", "supersedes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "requirement": {"enum": ["legal_identity", "active_company", "services", "geography", "decision_maker", "contact_route", "duplicate_identity"]},
        "state": {"enum": ["VERIFIED", "MISSING", "CONFLICT", "STALE", "NOT_APPLICABLE"]},
        "value": {"type": "object", "description": "Structured requirement-specific values documented in REVIEW-EVIDENCE.md; positive legal/status/contact values receive additional runtime validation."},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "method": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "attempt": {
      "type": "object",
      "required": ["id", "action", "at", "seconds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "action": {"enum": ["reserve", "complete"]},
        "at": {"$ref": "#/$defs/timestamp"},
        "seconds": {"type": "number", "minimum": 0},
        "kind": {"enum": ["search", "page", "api", "cache"]},
        "query": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "retry_of": {"type": "string", "minLength": 1},
        "retry_after_seconds": {"type": "number", "minimum": 0},
        "outcome": {"enum": ["success", "transient_error", "auth_error", "access_error", "unavailable", "permanent_error", "interrupted"]}
      },
      "allOf": [
        {"if": {"properties": {"action": {"const": "reserve"}}}, "then": {"required": ["kind"], "properties": {"seconds": {"exclusiveMinimum": 0}}}},
        {"if": {"properties": {"action": {"const": "complete"}}}, "then": {"required": ["outcome"]}}
      ]
    },
    "event": {
      "type": "object",
      "required": ["action", "reason", "at", "attempt_count", "finding_count"],
      "properties": {
        "action": {"enum": ["park", "reopen"]},
        "reason": {"type": "string", "minLength": 1},
        "at": {"$ref": "#/$defs/timestamp"},
        "attempt_count": {"type": "integer", "minimum": 0},
        "finding_count": {"type": "integer", "minimum": 0},
        "reason_type": {"enum": ["new_evidence", "changed_input", "freshness", "budget_reset"]}
      }
    },
    "record": {
      "type": "object",
      "required": ["id", "business", "findings", "attempts", "events"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
        "business": {"type": "string", "minLength": 1},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
      }
    }
  }
}
