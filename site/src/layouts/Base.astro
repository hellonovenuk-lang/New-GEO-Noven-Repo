---
import '../styles/signal.css';
import { business, plan, money, addressLines } from '../data/business';
import { organizationSchema } from '../data/schema';
import { orderHref } from '../data/order';
import { legalNavItems } from '../data/legal';
import { toSource } from '../lib/json-code';
interface Props { title: string; description: string; schema?: object[]; noindex?: boolean; }
const { title, description, schema = [], noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const audit = plan('audit');
const quietFooter = path.startsWith('/contact') || path.startsWith('/order');
const navigation = [
  { href: '/how-it-works/', label: 'The audit' },
  { href: '/ask-your-ai/', label: 'The evidence' },
  { href: '/pricing/', label: 'Pricing' },
];
const current = (href: string) => path.replace(/\/$/, '') === href.replace(/\/$/, '');
---
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#101211" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wardith — when your customers ask an AI who to use, the answer should include you." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Manrope:wght@400;500;600;650;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={toSource(organizationSchema(Astro.site))} />
    {schema.map((item) => <script type="application/ld+json" set:html={toSource(item)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-route={path}>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="header">
      <div class="shell header-inner">
        <a href="/" class="brand" aria-label="Wardith home"><img src="/logo-dark.svg" alt="Wardith" width="1298" height="238" /></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">+</span></button>
        <nav id="navigation" class="navigation" aria-label="Main navigation">
          <div class="navigation-links">{navigation.map((item) => <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>)}</div>
          <a href={orderHref} class="button button-nav" aria-current={current(orderHref) ? 'page' : undefined}>Start your audit <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      {!quietFooter && <div class="footer-invitation">
        <div class="shell invitation-grid">
          <div><p class="eyebrow">Your next move</p><h2>Let’s bring your<br />business into focus.</h2></div>
          <div class="invitation-action"><p>A clear view of where you stand.<br />A practical plan for what comes next.</p><a class="button button-dark" href={orderHref}>Start with the {money(audit.price)} audit <span aria-hidden="true">↗</span></a><span class="fine">One-off. No ongoing commitment.</span></div>
        </div>
      </div>}
      <div class="shell footer-content">
        <div class="footer-topline"><a class="footer-email" href={`mailto:${business.email}`}>{business.email}</a><p>Independent AI visibility.<br />Wirral based. Working across the UK.</p></div>
        <div class="footer-navigation"><nav aria-label="Footer navigation">{navigation.map((item) => <a href={item.href}>{item.label}</a>)}<a href="/about/">About</a><a href="/faq/">FAQ</a><a href="/contact/">Contact</a></nav><nav aria-label="Legal navigation">{legalNavItems.map((item) => <a href={item.href}>{item.label}</a>)}{business.businessLinkedIn && <a href={business.businessLinkedIn}>LinkedIn ↗</a>}</nav></div>
        <a href="/" class="footer-wordmark" aria-label="Wardith home"><img src="/logo-dark.svg" alt="Wardith" width="1298" height="238" loading="lazy" /></a>
        <div class="footer-legal"><span>© {new Date().getFullYear()} Wardith</span><p>{business.legalNote} Based in {business.basedIn}. Not VAT registered. Documents may be served at {addressLines(business.addressForService).join(', ')}.</p></div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.getElementById('navigation');
      const closeMenu = (restoreFocus = false) => {
        toggle?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('open');
        if (restoreFocus) toggle?.focus();
      };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('open', open);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') closeMenu(true);
      });
      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !nav?.contains(event.target) && !toggle?.contains(event.target)) closeMenu();
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));
      window.matchMedia('(min-width: 901px)').addEventListener('change', () => closeMenu());
    </script>
  </body>
</html>
