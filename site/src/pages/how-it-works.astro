---
import Base from '../layouts/Base.astro';
import AuditExplorer from '../components/AuditExplorer.astro';
import { orderHref } from '../data/order';
import Statement from '../components/Statement.astro';
import { business, plan, money } from '../data/business';

const title = 'How it works — Wardith';
const description =
  'How Wardith gets your business found by AI assistants: a £250 audit of where you stand, a one-off Foundation setup, and an ongoing monthly plan to keep you visible.';

const audit = plan('audit');
const foundation = plan('foundation');
const maintain = plan('maintain');

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: business.serviceName,
  serviceType: business.serviceType,
  provider: { '@id': new URL('/#organization', Astro.site).href },
  areaServed: business.areaServed,
  description:
    'Wardith audits how AI assistants such as ChatGPT, Google, Copilot and Perplexity currently answer questions about a business, fixes what is blocking the business from being found, and maintains that visibility month to month.',
};
---
<Base title="The visibility audit — Wardith" description={description} schema={[howToSchema]}>
  <section class="page-hero"><div class="shell page-hero-grid"><div><p class="eyebrow">The visibility audit</p><h1>Know what AI<br /><span>makes of you.</span></h1><p class="page-lede">A clear record of where you appear, what the assistants believe about your business, and what you can do about it.</p></div><aside class="page-aside"><div class="number">{money(audit.price)} <small>one-off</small></div><p>Written for your business. Delivered within two working days of confirmed scope and payment.</p><a class="button button-accent" href={orderHref}>Start your audit <span aria-hidden="true">↗</span></a></aside></div></section>
  <section class="section"><div class="shell product-grid"><div class="product-intro"><p class="eyebrow">The report you receive</p><h2>Evidence you<br />can act on.</h2><p>We test ten questions your customers would ask, repeatedly across the major assistants. Then we examine your website and public business information to investigate the findings.</p><p>You get the recorded answers, our diagnosis, and a recommendation on what is worth doing next. The report is yours to use with any provider.</p></div><AuditExplorer /></div></section>
  <section class="section section--tint"><div class="shell process-grid"><div><p class="eyebrow">From first email to clear priorities</p><h2>Here’s how<br />we get there.</h2></div><div><article class="process-step"><span>01</span><div><h3>Agree the questions</h3><p>Tell us your business, website, services and the area you cover. We confirm scope and payment before starting.</p></div></article><article class="process-step"><span>02</span><div><h3>Record the answers</h3><p>We ask the assistants repeatedly and record what comes back, including the businesses mentioned and what is said about yours.</p></div></article><article class="process-step"><span>03</span><div><h3>Investigate the gaps</h3><p>We check crawler access, relevant website content, and public business facts across profiles, directories and registers.</p></div></article><article class="process-step"><span>04</span><div><h3>Give you a recommendation</h3><p>What we found, why it matters and what to do next. If spending more with us isn’t justified, we say so.</p></div></article></div></div></section>
  <section class="section"><div class="shell process-grid"><div><p class="eyebrow">After the audit</p><h2>You decide<br />what happens next.</h2></div><div><div class="editorial-note"><h3>Fix the foundations</h3><p>The {money(foundation.price)} Foundation addresses agreed issues on your existing website: crawler access, structured business information, consistent facts across the web, and two permanent answer pages.</p><p>If your main issue needs different work, the audit explains that. We don’t sell website rebuilds or take developer referral fees.</p></div><div class="editorial-note" style="margin-top: 1.5rem;"><h3>Keep checking</h3><p>Optional monthly plans from {money(maintain.price)}. Maintain checks ten questions and keeps business facts current. Grow covers fifteen and adds one answer page each month. Lead covers twenty-five, adds two pages, and includes a quarterly competitor review.</p><a class="text-link" href="/pricing/">See the plans <span aria-hidden="true">↗</span></a></div></div></div></section>
  <section class="section section--invert"><div class="shell section-heading"><p class="eyebrow">A necessary distinction</p><div><h2>We improve what<br />you can influence.</h2><p style="margin-top: 1.5rem; max-width: 40rem;">AI assistants decide what to recommend. We can promise a documented process, recorded evidence and work on specific issues. We can’t promise that an assistant will name you.</p></div></div></section>
</Base>
