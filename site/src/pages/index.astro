---
import Base from '../layouts/Base.astro';
import Code from '../components/Code.astro';
import Statement from '../components/Statement.astro';
import { plan, money } from '../data/business';
import { organizationSchema } from '../data/schema';

const title = 'Wardith — Get found when customers ask AI who to use';
const description =
  'Wardith helps accountants, solicitors, clinics, consultancies and agencies get found and recommended when customers ask ChatGPT, Google, Copilot or Perplexity who to use. Start with a £250 audit.';

const audit = plan('audit');
const foundation = plan('foundation');
const maintain = plan('maintain');

// Not a copy of the structured data — the structured data. The layout renders
// this exact object into the page head.
const orgSchema = organizationSchema(Astro.site);

/* The lines in that record worth stopping on, in the words a client would use.
 * Keyed by path, not by line number, so adding a fact to `business.ts` can
 * never leave these pointing at the wrong lines. Keep this to a handful:
 * marking everything is the same as marking nothing. */
const recordNotes = {
  name: 'Your name, spelled one way. An assistant that finds three versions of it across the web trusts none of them.',
  description:
    'One sentence on what you do and who for. This is roughly what gets repeated back when somebody asks about you.',
  email:
    'How a customer actually reaches you. A recommendation carrying the wrong contact details is a lost enquiry, not a win.',
  areaServed:
    'Where you work, written the standard way — GB is the country code for the United Kingdom. Nothing here has to be interpreted.',
  'founder.name':
    'A real person, named. A business that will not say who is behind it gives these systems nothing to check.',
};
---

<Base title={title} description={description}>
  <section class="hero hero--rules">
    <div class="wrap">
      <h1>When your customers ask an AI who to use, the answer should include you.</h1>
      <p class="lede" data-reveal>
        People increasingly ask ChatGPT, Google, Copilot and Perplexity to recommend an
        accountant, a solicitor, a clinic or a consultancy — instead of scrolling through search
        results. Wardith finds out whether those systems can find you, understand you and
        recommend you, and fixes what's in the way.
      </p>
      <div data-reveal>
        <div class="cta-row">
          <a class="btn" href="/contact/">
            Order the {money(audit.price)} audit
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path
                d="M9 1l4 4-4 4M13 5H1"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"></path>
            </svg>
          </a>
          <a href="/ask-your-ai/">Or check us yourself, first</a>
        </div>
        <p class="cta-note">
          The audit is a written report on where you show up today and what's in the way — no
          obligation beyond the {money(audit.price)}. The second link is the same audit run on
          ourselves and published in full, including the finding that made us change the name of
          the company.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--sticky">
      <div data-reveal>
        <h2>Why does this matter now?</h2>
      </div>
      <div data-reveal>
        <p>
          Buying habits have changed. Someone who needs a professional service used to type a query
          into Google and compare the results themselves. Now, many of them put the question to an
          AI assistant instead.
        </p>

        {/* The whole commercial problem, drawn once. Both lanes show the same
            ten businesses, so the difference the reader sees is exposure
            rather than quality: on a results page all ten are there to be
            compared; in an answer, most of them are simply never said out
            loud. The prose underneath used to carry this and no longer has
            to. Nothing here is a measured figure — it is the shape of the
            thing, and the shape is the argument. */}
        <figure class="lanes">
          <figcaption class="lanes-ask">
            A customer asks:
            <span class="lanes-q">“Who's a good commercial solicitor near Manchester?”</span>
          </figcaption>

          <div class="lanes-pair">
            <div class="lane">
              <p class="lane-title">On a search engine</p>
              <ul class="lane-marks" aria-hidden="true">
                <li></li><li></li><li></li><li></li><li></li>
                <li></li><li></li><li></li><li></li><li></li>
              </ul>
              <p class="lane-note">
                Every firm that matches is on the page somewhere. The customer compares them and
                picks.
              </p>
            </div>

            <div class="lane">
              <p class="lane-title">Through an AI assistant</p>
              <ul class="lane-marks" aria-hidden="true">
                <li class="is-named"></li><li class="is-named"></li><li class="is-named"></li>
                <li class="is-unnamed"></li><li class="is-unnamed"></li><li class="is-unnamed"></li>
                <li class="is-unnamed"></li><li class="is-unnamed"></li><li class="is-unnamed"></li>
                <li class="is-unnamed"></li>
              </ul>
              <p class="lane-note">
                A handful of names come back. The rest aren't ranked lower — they're not in the
                answer.
              </p>
            </div>
          </div>

          <p class="lanes-foot">
            So a business can now be left out before the customer ever reaches its website — and
            there's no results page to check, so nobody tells you it happened.
          </p>
        </figure>

        <p style="margin-top: 1.5rem;">
          The businesses that do appear tend to be the ones whose information these systems can
          find, read and corroborate. Most of that is fixable, and it's what Wardith works on.
        </p>
      </div>
    </div>
  </section>

  {/* Diagnosis before intervention, said early and plainly. It sits this high
      because it is the fastest way to separate an audit from a sales funnel,
      and a cold reader decides which one this is within a screen or two. */}
  <section class="section">
    <div class="wrap split split--sticky">
      <div data-reveal>
        <h2>What if there's nothing wrong?</h2>
      </div>
      <div data-reveal>
        <p>
          Then the report says so and that's the end of it. The {money(audit.price)} audit is a
          diagnosis rather than a sales call with a document attached: it stands on its own, it's
          yours to keep, and you could act on it yourself or hand it to somebody else entirely.
        </p>
        <p>
          Sometimes the biggest thing in the way isn't something we sell. When we ran this audit on
          our own business, the finding was that the company had picked the wrong name — so that is
          what the report said, ahead of any of the work we'd have been paid for.
          <a href="/ask-your-ai/self-audit/">Read it</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="split" style="margin-bottom: 3rem;">
        <div data-reveal>
          <h2>What does Wardith actually do?</h2>
        </div>
        <div data-reveal>
          <p>
            Wardith makes your business easy for AI assistants to find, understand and recommend. In
            practice that means three kinds of work.
          </p>
        </div>
      </div>

      <div class="stages">
        <div class="stage" data-reveal>
          <div class="stage-head">
            <h3>We find out where you stand.</h3>
          </div>
          <div class="stage-body">
            <p>
              We ask the major AI assistants the questions your customers ask, record what they say
              about you and your competitors, and trace why.
            </p>
          </div>
        </div>
        <div class="stage" data-reveal>
          <div class="stage-head">
            <h3>We fix what's blocking you.</h3>
          </div>
          <div class="stage-body">
            <p>
              When a business is missing, the reason is usually mundane and correctable:
              information the crawlers can't read, facts about the business that disagree with each
              other across the web, or pages that never answer the questions customers actually
              ask.
            </p>
          </div>
        </div>
        <div class="stage" data-reveal>
          <div class="stage-head">
            <h3>We keep you visible.</h3>
          </div>
          <div class="stage-body">
            <p>
              The assistants and their sources change constantly. Ongoing plans keep your
              information current and extend your coverage to more of the questions that matter to
              you.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <Statement
        cite="There is no button we press that makes an AI recommend you. There are identifiable things that make a business easier to find, understand and corroborate — we work out which of yours are weak, and fix the ones we can influence."
      >
        It's methodical work, <em>not a trick.</em>
      </Statement>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--sticky">
      <div data-reveal>
        <h2>Who is this for?</h2>
      </div>
      <div data-reveal>
        <p>
          Service businesses whose customers research and compare before buying: accountants,
          solicitors, private clinics, consultancies and agencies. If a client is worth hundreds or
          thousands of pounds to you, being one of the three names an AI suggests is worth taking
          seriously.
        </p>
        <p>
          It's a poor fit if your customers buy on impulse, or if you already have more work than
          you can take on.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--invert">
    <div class="wrap split">
      <div data-reveal>
        <h2>Where's the proof?</h2>
      </div>
      <div>
        <div data-reveal>
          <p>
            Wardith is a new business, and we don't yet have client case studies to show you. We won't
            invent any, and we'd encourage you to be suspicious of anyone in this field who shows
            you numbers that can't be checked.
          </p>
          <p>
            What we can show you is the method, run on ourselves before we sold it to anybody: ten
            questions, four assistants, 228 recorded answers — and we failed. The report is
            <a href="/ask-your-ai/self-audit/">published in full</a>, including the finding that
            made us change the name of the business. Read it, or hand it to whichever assistant you
            already use and ask what it makes of the work — <a href="/ask-your-ai/">the prompt is
            written for you</a>, alongside the ones for testing your own business and for checking
            any provider you're considering, us included.
          </p>
          <p>
            Then there's this website. It's built exactly the way we build for clients — plain, fast
            pages that assistants can read, structured information about the business, and a
            <a href="/faq/">real FAQ</a> that answers the questions people actually ask. Check it
            yourself: view this page's source and compare it with the record below. Those are the
            same bytes, not a picture of them.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* The record. It sits below the proof section rather than beside the hero,
      where it used to be: it is the strongest thing on the page for a reader
      who already believes there is a problem, and the weakest for one who
      doesn't. Cold traffic meets the argument first and the JSON afterwards. */}
  <section class="section">
    <div class="wrap split split--sticky">
      <div data-reveal>
        <h2>What an assistant reads on this page</h2>
      </div>
      <div data-reveal>
        <p>
          You're reading this page. An AI assistant reads the block below instead — the same facts
          about the business, written so a machine doesn't have to infer them from the layout. It's
          the part no visitor ever sees, and on most business websites there's nothing there at all.
        </p>
        <Code
          class="record-panel"
          caption="What an AI assistant reads on this page"
          label="Wardith's structured data, as JSON-LD"
          data={orgSchema}
          typing
          notes={recordNotes}
          notesHint="The marked lines are the facts an assistant repeats back about a business. Point at one — or tap it — to see what it does."
          note="This is the real thing, not an example: the same block sits in this page's source. View source and you'll find it."
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--sticky">
      <div data-reveal>
        <h2>What does it cost?</h2>
      </div>
      <div data-reveal>
        <p>
          One service in three stages, priced in plain numbers. Diagnose: a
          <strong>{money(audit.price)} audit</strong> of where you currently show up. Fix: if
          there's work worth doing, the <strong>{money(foundation.price)} Foundation</strong> setup
          addresses what the audit found. Keep checking: a monthly plan from
          <strong>{money(maintain.price)}</strong>. Full details, including what's in each part, are
          on the <a href="/pricing/">pricing page</a>.
        </p>
        <p>
          Every stage has to earn the next one. The audit is priced so that finding out where you
          stand is an easy decision, and nothing obliges you to buy what comes after it.
        </p>
      </div>
    </div>
  </section>
</Base>
