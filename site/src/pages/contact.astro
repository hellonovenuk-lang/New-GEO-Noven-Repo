---
import Base from '../layouts/Base.astro';
import { business, plan, money } from '../data/business';
import { orderPageLive } from '../data/order';
const audit = plan('audit');
const auditEmail = `mailto:${business.email}?subject=${encodeURIComponent('An audit for my business')}&body=${encodeURIComponent('Hi Kieran,\n\nI’m interested in the Wardith audit.\n\nBusiness name: \nWebsite: \nServices I want to be found for: \nArea I serve: \n\nThanks')}`;
---
<Base title="Start a conversation — Wardith" description="Ask Kieran a question or request your £250 AI visibility audit. A personal reply within two working days.">
<section class="hero hero--rules"><div class="wrap"><p class="section-label">Let’s look at your business</p><h1>One email.<br /><em>A clearer picture.</em></h1><p class="lede">Tell me about your business and I’ll confirm the scope of your audit. You’ll get a personal reply within two working days.</p></div></section>
<section class="section"><div class="wrap contact-grid"><div><h2>What I need to get started.</h2><ol class="contact-list"><li>Your business name</li><li>Your website address</li><li>The services you want to be found for</li><li>The area you serve</li></ol><p>If you know the questions customers usually ask, include those too.</p><a class="contact-email" href={`mailto:${business.email}`}>{business.email}</a><p class="micro">Just have a question? The same address works.</p></div><aside class="contact-card"><p class="section-label">Your starting point</p><h2>The {money(audit.price)} audit.</h2><p>A written report on where your business appears, what the assistants get right or wrong, and what to do next.</p><a class="btn" href={orderPageLive ? '/order/' : auditEmail}>{orderPageLive ? 'Go to the order form' : 'Email Kieran about an audit'} <span aria-hidden="true">↗</span></a><p class="micro">{orderPageLive ? 'Confirm your details before payment.' : 'Opens your email app with the details to fill in.'}</p><ol class="mini-timeline"><li><strong>First, we agree the scope</strong>I’ll reply within two working days and confirm payment details.</li><li><strong>Then, you get your report</strong>Within two working days of scope and payment being confirmed.</li></ol><p class="micro">One-off price. No VAT to add. Further work is optional.</p></aside></div></section>
</Base>
