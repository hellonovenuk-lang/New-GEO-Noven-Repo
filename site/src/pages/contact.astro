---
import Base from '../layouts/Base.astro';
import { business, plan, money } from '../data/business';
import { orderPageLive } from '../data/order';
const audit = plan('audit');
const auditEmail = `mailto:${business.email}?subject=${encodeURIComponent('An audit for my business')}&body=${encodeURIComponent('Hi Kieran,\n\nI’m interested in the Wardith audit.\n\nBusiness name: \nWebsite: \nServices I want to be found for: \nArea I serve: \n\nThanks')}`;
---
<Base title="Start your audit — Wardith" description="Start with a £250 visibility audit. Tell Kieran about your business for a personal reply within two working days.">
  <section class="contact-page"><div class="shell"><div class="contact-layout"><div class="contact-intro"><p class="eyebrow">Let’s start with your business</p><h1>Your next step<br /><span>starts here.</span></h1><p>A short email is all we need to begin. Tell me what you do and where you want to be found. I’ll confirm the scope of your audit and how to pay.</p><div class="contact-person"><span class="monogram" aria-hidden="true">KS</span><p>Kieran Smith<small>Founder, researcher, and your point of contact.</small></p></div></div><div class="contact-panel"><p class="eyebrow">The {money(audit.price)} visibility audit</p><h2>Tell me four things.</h2><ol class="contact-checklist"><li>Your business name</li><li>Your website address</li><li>The services you want to be found for</li><li>The area you serve</li></ol><a class="button button-dark" href={orderPageLive ? '/order/' : auditEmail}>{orderPageLive ? 'Go to the order form' : 'Email Kieran to get started'} <span aria-hidden="true">↗</span></a><p class="fine">{orderPageLive ? 'Confirm your details before payment.' : 'Opens your email app with a short message ready to fill in.'} Nothing is sent automatically.</p><div class="contact-direct"><p>Just have a question? Write directly.</p><a href={`mailto:${business.email}`}>{business.email}</a></div></div></div><div class="contact-timing"><p><strong>A personal reply within two working days.</strong>We agree scope and payment before the work begins.</p><p><strong>Your report within two working days after that.</strong>One-off price. No VAT to add. Further work is optional.</p></div></div></section>
</Base>
