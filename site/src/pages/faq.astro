---
import Base from '../layouts/Base.astro';
import { money, plan } from '../data/business';

const title = 'Frequently asked questions — Wardith';
const description =
  'Plain answers about getting your business found by AI assistants: how recommendations work, what the £250 audit covers, timescales, guarantees, which assistants Wardith covers, and whether this is the thing the industry calls GEO or AEO.';

const audit = plan('audit');

// Single source of truth: this array renders the visible FAQ and the
// FAQPage structured data, so the two can never drift apart.
const faqs: { q: string; a: string[] }[] = [
  {
    q: 'How do AI assistants decide which businesses to recommend?',
    a: [
      'AI assistants build their answers from what they can find and read: your website, directories, reviews, professional registers and other public sources. When someone asks for a recommendation, the assistant favours businesses whose information is easy to read, consistent across sources, and clearly matched to the question — the right service, the right place, the right specialism.',
      'No one outside these companies knows the exact mechanics, and anyone who claims to is overselling. But the inputs are observable: businesses with clear, consistent, machine-readable information get found and described accurately; businesses without it get ignored or described wrongly. Wardith works on those inputs.',
    ],
  },
  {
    q: 'What exactly do I get for the £250 audit?',
    a: [
      'A short written report, in plain English, covering three things: what the major AI assistants currently say when asked the questions your customers ask; what they know and believe about your business specifically, and whether it is accurate; and what is blocking you, with our recommendation on what to do about it.',
      'We put ten questions to each assistant repeatedly rather than once, because their answers vary from run to run, and we quote what came back word for word — including the competitors named ahead of you.',
      'If the audit shows you are already in good shape, the report says so, and we will not push you towards the next stage. £250 is the whole cost, with no obligation.',
      'We reply to enquiries within two working days, and you will have the report within two working days of us confirming scope and payment.',
    ],
  },
  {
    q: 'What happens after the audit?',
    a: [
      'That depends entirely on what the audit found, which is the point of doing it first. If there is nothing meaningful to fix, the process ends there and you have spent £250 finding that out.',
      'If there is something to fix, the report says what it is and what we would recommend. Where the work falls inside what Wardith does, that is the Foundation — the fixed-scope setup described on the how it works page. Where it does not, the report says so and explains what should be handled elsewhere, by you or by somebody else. When we ran this audit on our own business, the biggest recommendation was a name change, which is not something we sell.',
      'Either way, you decide whether anything happens next. Buying the audit does not commit you to the stage after it.',
    ],
  },
  {
    q: 'Can you guarantee that AI assistants will recommend my business?',
    a: [
      'No — and nobody honestly can. These systems are controlled by OpenAI, Google, Microsoft and Perplexity, not by us, and their answers vary and change. Treat anyone who guarantees you a spot in AI recommendations the way you would treat someone guaranteeing you a court win.',
      'What we can do is put the important factors we can actually observe and influence in place for your business, and then show you plainly how you are showing up over time. The work is real and checkable; the outcome is influenced, not controlled.',
    ],
  },
  {
    q: 'How long does it take to see results?',
    a: [
      'Some changes take effect within weeks — assistants that browse the live web, like Perplexity and the search modes of ChatGPT and Copilot, can begin picking up improved pages once those pages have been recrawled and reprocessed. That is a step towards being recommended rather than the same thing as it. Other changes take months, because some systems update their underlying knowledge slowly.',
      'The honest answer is that timescales vary by business and by assistant, and we will not pretend otherwise. This is why we monitor and report how you are actually showing up, rather than asking you to take progress on faith.',
    ],
  },
  {
    q: 'Is this the same as getting to the top of Google?',
    a: [
      'It overlaps, but it is not the same job. Ranking in a list of blue links is about competing for position on a results page. Being recommended by an AI assistant is about being found, understood and trusted by a system that gives one short, conversational answer.',
      'Much of the groundwork helps both — clear pages and consistent facts never hurt your Google presence. But the specific work of being quotable and machine-readable for AI assistants is different, and most businesses have never had it done.',
    ],
  },
  {
    q: 'Is this what people call GEO or AEO?',
    a: [
      'Yes. The industry has several names for this work — GEO, for generative engine optimisation; AEO, for answer engine optimisation; and a few others, sometimes just “AI SEO”. None of them has settled as the standard term, and new ones keep arriving. If you have been reading about this and turned up holding one of those acronyms, you are in the right place.',
      'The names matter less than the work, which is specific and fairly unglamorous: making sure AI assistants can read your website properly, making sure the facts about your business agree with each other everywhere they appear, and making sure something you have published actually answers the question your customer asked.',
      'We do not use those acronyms anywhere else on this site. Not because they are wrong, but because almost none of our customers use them — a plumber losing work to a competitor does not think of it as an optimisation problem. This answer is here so the people who do know the terms can see we mean the same thing.',
    ],
  },
  {
    q: 'Do I need a new website for this to work?',
    a: [
      'Almost certainly not. We work on the website you already have — the fixes are about what your site says and how machines read it, not how it looks. Wardith does not build websites.',
      'If your site has a problem so fundamental that our work would be wasted on it, the audit will tell you that honestly before you spend anything more.',
    ],
  },
  {
    q: 'What if my website cannot be updated?',
    a: [
      'It happens more often than you would think. The person who built it has moved on, or nobody can find the login, or it sits on a system that will not accept the changes. If that is your situation, the audit still does its job: it tells you what is wrong, what is missing, and what it would take to put right.',
      'That list does not depend on us being the ones to act on it. The report is yours to keep and yours to hand to whoever does look after your site — or to whoever builds the next one. It is written to be specific enough for a stranger to work from.',
      'We do not build websites, we do not recommend anyone who does, and we take nothing from anyone you choose. We have no stake in who fixes it. If the answer is that our next stage would be wasted on your site as it stands, we will tell you that in the report rather than sell it to you anyway — and if you sort the site out later, we will still be here at the same published price.',
    ],
  },
  {
    q: 'Which AI assistants does this cover?',
    a: [
      'The ones your customers actually use: ChatGPT, Google’s AI-generated results and Gemini, Microsoft Copilot, and Perplexity. The same groundwork should also serve newer assistants as they appear, because they draw on many of the same kinds of public sources — though that is a reasonable expectation rather than something anyone can promise about a system that does not exist yet.',
    ],
  },
  {
    q: 'What do you need from me?',
    a: [
      'For the audit: your business name, website address, the services you most want to be found for, and the area you serve. Two optional extras make the report sharper — what people usually ask when they first get in touch, and roughly what a new customer is worth to you. The first gets us your customers’ words rather than ours; the second lets us tell you what being missing is actually costing.',
      'For the Foundation and ongoing work: access to update your website (or a contact for whoever manages it), and a little of your time to verify facts about the business. You will not need to write anything yourself unless you want to.',
    ],
  },
  {
    q: 'Am I locked into a contract?',
    a: [
      'No. The audit and the Foundation are one-off payments. The monthly plans roll month to month with no minimum term — tell us before your next payment date and that is the end of it. Moving up or down a level works the same way.',
    ],
  },
  {
    q: 'Who will I actually be dealing with?',
    a: [
      'Kieran Smith, who runs Wardith as a sole trader from the Wirral. Wardith is one person, not an agency with an account manager in front of it — the person who answers your email is the person who does the work and writes your report.',
      'Everything runs by email rather than phone, so there is a written record of what was asked and what was promised. Wardith is not VAT registered, so the prices you see are the prices you pay.',
    ],
  },
  {
    q: 'Why should I trust a company with no case studies?',
    a: [
      'You should be sceptical — that is the right instinct, and we would rather meet it head-on than dodge it. Wardith is new, and we do not yet have client results to show. We refuse to invent any.',
      'Three things stand in the meantime. First, we ran the audit on our own business before selling one to anybody, failed it, and published the report in full — including the finding that made us change the company name, which was a recommendation to do something we do not sell. Second, this website is itself built the way we build for clients, and you can check it without taking anything on trust: every answer on this page is also published in machine-readable form in the page’s source, so view the source and see that the two say the same thing. Third, the audit exists so you can judge us on a piece of finished work before committing to anything larger — it is the smallest thing we sell, it stands on its own, and nothing obliges you to buy the next stage.',
    ],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a.join(' '),
    },
  })),
};

/** Paragraphs are authored plain, but owner placeholders must stand out. */
const isFlag = (text: string) => text.trim().startsWith('[PLACEHOLDER');
---

<Base title={title} description={description} schema={[faqSchema]}>
  <section class="hero hero--rules">
    <div class="wrap">
      <h1>Frequently asked questions</h1>
      <p class="lede" data-reveal>
        Plain answers, including the ones that don't flatter us. If your question isn't here,
        <a href="/contact/">ask us directly</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {
        faqs.map((item) => (
          <div class="qa" data-reveal>
            <h2>{item.q}</h2>
            <div class="qa-answer">
              {item.a.map((para) =>
                isFlag(para) ? <p class="flag">{para}</p> : <p>{para}</p>,
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--invert">
    <div class="wrap split">
      <div data-reveal>
        <h2>Don't take our word for any of this.</h2>
      </div>
      <div data-reveal>
        <p>
          Every answer above is also published as structured data on this page, giving machines an
          explicit version of the same information rather than forcing them to infer it from the
          visual layout. View the source and read it: the {money(audit.price)} audit is described
          there in the same words it is described in here, because both are built from one file.
          That is the whole method, run on ourselves.
        </p>
      </div>
    </div>
  </section>
</Base>
