{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/repo-consistency/scripts/check.py)",
      "Bash(python3 .claude/skills/repo-consistency/scripts/check.py *)",
      "Bash(python3 *)",
      "Bash(py *)",
      "Bash(python *)",
      "Bash(mkdir -p ~/wardith-runs/*)",
      "Bash(mkdir -p content/context-watch)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "PowerShell",
      "WebFetch",
      "WebSearch",
      "Bash(bash scripts/cloud-session-secrets.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-secrets.sh"
          }
        ]
      }
    ]
  }
}
